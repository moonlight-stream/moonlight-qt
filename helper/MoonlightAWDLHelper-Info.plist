     satisfy to install, update, or remove this helper via SMJobBless.
     The requirement below matches any Apple-issued certificate for the
     Moonlight app bundle identifier; if you sign with a purely self-signed
     local certificate, replace "anchor apple generic" with the requirement
     matching that certificate (e.g. one naming its anchor). -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.moonlight-stream.Moonlight.AWDLHelper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MoonlightAWDLHelper</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>SMAuthorizedClients</key>
	<array>
		<string>identifier "com.moonlight-stream.Moonlight" and anchor apple generic</string>
	</array>
</dict>
</plist>
